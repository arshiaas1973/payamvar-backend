// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         BigInt            @id @default(autoincrement()) @db.BigInt
  firstName  String            @db.VarChar(100)
  lastName   String            @db.VarChar(100)
  email      String            @unique @db.Text
  username   String?           @unique @db.VarChar(200)
  bio        String?           @db.VarChar(500)
  birthday   String?           @db.VarChar(12)
  password   String            @db.Text
  resetToken String?           @db.Text
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  deletedAt  DateTime?         @db.Timestamp(6)
  sessions   UserSession[]
  medias     UserMediaOnUser[]

  @@index([email, resetToken, username])
}

model UserMediaOnUser {
  id        BigInt    @id @default(autoincrement()) @db.BigInt
  user_id   BigInt    @db.BigInt
  media_id  BigInt    @db.BigInt
  user      User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  media     UserMedia @relation(fields: [media_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model UserMedia {
  id        BigInt            @id @default(autoincrement()) @db.BigInt
  url       String            @db.Text
  type      Int               @db.SmallInt
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  deletedAt DateTime?         @db.Timestamp(6)
  users     UserMediaOnUser[]
}

model UserSession {
  id         BigInt    @id @default(autoincrement()) @db.BigInt
  user_id    BigInt    @db.BigInt
  deviceName String    @db.VarChar(200)
  ipAddress  String    @db.VarChar(45)
  status     Int       @default(1) @db.SmallInt
  last_seen  String    @default("Online") @db.VarChar(100)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime? @db.Timestamp(6)
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
}
